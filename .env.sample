# ==============================================================================
# EMS (EXPENSE MANAGEMENT SYSTEM) - SAMPLE ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and update values with your environment credentials.
# ==============================================================================

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local MongoDB instance)
MONGODB_URI="mongodb://localhost:27017/expense_manager_db"

# JWT Secret Key used for signing session tokens
JWT_SECRET="spendflow-secure-jwt-secret-key-change-this-in-production"

# Public Application Logo URL
NEXT_PUBLIC_APP_LOGO_URL="/logo.svg"

# ------------------------------------------------------------------------------
# Brevo (formerly Sendinblue) Transactional Email Integration
# If BREVO_API_KEY is omitted, system falls back to ConsoleEmailService logger.
# ------------------------------------------------------------------------------
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@example.com"
# Optional "from" display name. Leave blank to use the product name from
# src/config/branding.ts.
BREVO_SENDER_NAME=""

# ------------------------------------------------------------------------------
# Cloudinary Media Storage Integration (Supporting Documents & Receipts)
# If credentials are omitted, system falls back to mock file storage URLs.
# The API key MUST carry the "create" permission (Console -> Settings -> API Keys).
# A read-only key authenticates fine but every upload fails with a 403.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER=ems